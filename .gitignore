__pycache__/
*.pyc
parse_data.py
images/
*.bak
*.bak_new
*.bak_*
data/.r2_upload_state.json
data/*backup*
data/*.remote
images_tmp/
images_test_tmp/
node_modules/
.eslintignore

# 工作区记忆目录 / 临时文件，不进站点仓库
.workbuddy/

# 已废弃的遗留产物：内容已全部迁到 data/content/{分类}.json，
# 下面这些是历史单体/备份，不再被任何代码引用（见 data/content.json 7.5MB）
data/content.json
data/index.json.bak_reorder
data/index.json.trimmed_bak

# 构建时生成，不进仓库
content/_build_report.md

# data/ 全部由 tools/build.py 在构建时生成，不进仓库。
# 这样每次 push 只包含改动的那几条 content/posts/*.json，
# 而不是每次重传 15MB 生成物；同时也避免「有人手改生成物导致与源头不一致」。
data/

# 凭据与临时产物，绝不进仓库
cf-token.txt
*.token
.env
.env.*

# 恢复脚本的临时下载目录
.recover-tmp/
