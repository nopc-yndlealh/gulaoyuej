  "tieba_7602411996": {
    "title": "以前杂交一个蓝紫色大花品种",
    "type": "月季",
    "segments": [
      {
        "t": "奶油棒冰🍭 我看到了伤痕累累的手臂 逆风机长 多拍点啊 还是虚焦的 小欧小亮 可以多介绍一下啊 ☞烛姬☜ 后面那个枝条也是她的吗"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_7602411996_000.webp"
      }
    ],
    "author": {
      "name": "云小123456",
      "avatar": "https://gss0.bdstatic.com/6LZ1dD3d1sgCo2Kml5_Y_D3/sys/portrait/item/tb.1.93296799.4nCBkGapSNihAglzWd7jig?t=1779722050",
