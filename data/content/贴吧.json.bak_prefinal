      }
    ],
    "author": {
      "name": "云小123456",
      "avatar": "https://gss0.bdstatic.com/6LZ1dD3d1sgCo2Kml5_Y_D3/sys/portrait/item/tb.1.93296799.4nCBkGapSNihAglzWd7jig?t=1779722546",
      "url": "https://tieba.baidu.com/home/main?id=tb.1.93296799.4nCBkGapSNihAglzWd7jig%3Ft%3D1779722546"
    },
    "time": "2020-06-09 21:12",
    "tag": "309"
  },
  "tieba_6737058049": {
    "title": "月季新品种测试贴，美人丽芙/丽滨，这个品种是别的朋友送我的，",
    "type": "月季",
    "segments": [
      {
        "t": "月季新品种测试贴，美人丽芙/丽滨，这个品种是别的朋友送我的，首先大家来看看丽滨的宣传图，从宣传图看它是一个胭脂红的类似切花月季的品种，单看宣传照其实挺普通的，一般切花月季都能达到的颜值。"
