  "tieba_6106464332": {
    "title": "育种初学者问题答疑今天有个资深花友问我，月季育种除了表面的光",
    "type": "月季",
    "segments": [
      {
        "t": "育种初学者问题答疑 今天有个资深花友问我，月季育种除了表面的光鲜亮丽不好的地方在哪里？好像这个问题很多人都想知道，但是没有人解答，接下来我为大家答疑这个问题 首先给大家看看我去年冬天买的伊芙伯爵裸根大苗，裸根大苗去年需谨慎哦，有空的还是春天入苗吧"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6106464332_000.webp"
      }
    ],
    "author": {
      "name": "云小123456",
      "avatar": "https://gss0.bdstatic.com/6LZ1dD3d1sgCo2Kml5_Y_D3/sys/portrait/item/tb.1.93296799.4nCBkGapSNihAglzWd7jig?t=1779721687",
      "url": "https://tieba.baidu.com/home/main?id=tb.1.93296799.4nCBkGapSNihAglzWd7jig%3Ft%3D1779721687"
    },
    "time": "2019-04-19 18:45",
    "tag": "395"
  },
