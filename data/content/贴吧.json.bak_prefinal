  "tieba_6871526051": {
    "title": "木村卓功的两个蓝紫色月季品种，伊利亚特和丽拉",
    "type": "月季",
    "segments": [
      {
        "t": "木村卓功的两个蓝紫色月季品种，伊利亚特和丽拉"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6871526051_002.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6871526051_003.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6871526051_004.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6871526051_005.webp"
