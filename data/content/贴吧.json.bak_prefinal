  "tieba_7766816865": {
    "title": "德国鸢尾馥郁集",
    "type": "月季",
    "segments": [
      {
        "t": "iris pallida（香根鸢尾）\n\n花是葡萄酷爱饮料味"
      },
      {
        "t": "Ginger snap（姜饼）\n\n类似根汁啤酒的味道"
      },
      {
        "t": "Triple Play （三杀）\n\n像葡萄棒棒糖的味道"
      },
      {
        "t": "Gazellegant （瞪羚）\n\n具有风信子一般的香气"
      },
      {
        "t": "Batik（蜡染）\n\n甜美的葡萄果冻香气，类似传统的香鸢尾的芬芳。"
      },
      {
        "t": "ALICE HARDING（爱丽丝汉玎）\n\n于上世纪在美国农舍发现的古典品种\n强烈甜美的香气，香氛范围大"
      },
      {
        "t": "Calliope's Dream（卡丽俄佩之梦或者史诗繆斯的梦）\n\n强烈稀有的西柚芬芳"
      },
      {
        "t": "Grape Harvest（葡萄丰收）\n\n葡萄果酱的味道"
      },
      {
        "t": "ENGLISH COTTAGE（英国村舍）\n\n闻起来像晾干的亚麻衣服气息"
      },
      {
        "t": "GYPSY WOMAN （吉普赛女郎）\n\n甜美可爱的茴香糖味"
      },
      {
        "t": "IDOL'S DREAM（偶像之梦）\n\n柠檬酥塔的味道"
      },
      {
        "t": "LAST KNIGHT（终末骑士）\n\n像是喇叭水仙的味道"
      },
      {
        "t": "LIME MIST（青柠雾霭）\n\n柠檬香气"
      },
      {
        "t": "PETITE POLKA（小波尔卡舞）\n\n热可可的味道"
      },
      {
        "t": "POCAHONTAS（宝嘉康蒂）\n\n古典品种，甜蜜葡萄气息"
      },
      {
        "t": "SCOTTISH WARRIOR（苏格兰勇士）\n\n男性麝香古龙水味\n真是怪贴合这个名字的"
      },
      {
        "t": "Sneezy（打喷嚏）\n\n男性麝香古龙水味，不是令人愉悦的味道"
      },
      {
        "t": "SOUTHLAND GRAP（南土葡萄）\n\n强烈大范围香氛"
      },
      {
        "t": "Timeless Moment（永恒刹那）\n\n闻起来。。。像不愉快的男性腋窝味道"
      },
      {
        "t": "FRAGRANT CLOUD （香云）\n\n花香香型香水的感觉"
      },
      {
        "t": "Sugar Blues（蜜糖蓝调）\n\n甜美的泡泡糖味"
      },
      {
        "t": "中场休息，后续还会补"
      },
      {
        "t": "BLACK MAGIC（黑魔法）\n\n欧亚甘草的味道"
      },
      {
        "t": "BLATANT（明目的存在）\n\n麝香气息"
      },
      {
        "t": "GRAPE SITUATION（葡萄模样）\n\n葡萄气泡饮料的味道"
      },
      {
        "t": "SEPTEMBER SAILOR（九月水手）\n\n根汁啤酒的味道"
      },
      {
        "t": "English Charm（英式妩媚）\n\n像。。。猫尿的味道（迫真英式风情）"
      },
      {
        "t": "Amethyst Flame （紫晶之焰）\n\n廉价的肥皂味"
      },
      {
        "t": "Fancy Notion （奇思妙想）\n\n葡萄，酸樱桃糖味"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/d3597ecc87ab6493387aaccbfa13b641.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/d0f654d7b49ac40563ee47369e14f1ec.webp"
