  "tieba_6719330129": {
    "title": "【育种相关】这是一个绿鼻毛，是以前我用列达和多花蔷薇杂交的那",
    "type": "月季",
    "segments": [
      {
        "t": "【育种相关】这是一个绿鼻毛，是以前我用列达和多花蔷薇杂交的那个波浪边蔷薇，和奥斯汀杂交麝香的杂交后得到一个粉包子蔷薇，多季开花的，然后这个粉包子芽变了一个绿心的，后来这个绿心的又芽变出了一个绿心染红边的，我用这个和刚毛蔷薇与奥斯汀杂交后来与矮化蔷薇杂交变成了这样……除此之外，退一步的亲本中有其它粉色也会芽变绿心瓣，所以这样组合还挺有意思的"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719330129_001.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719330129_002.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719330129_003.webp"
      }
    ],
    "author": {
      "name": "云小123456",
      "avatar": "https://gss0.bdstatic.com/6LZ1dD3d1sgCo2Kml5_Y_D3/sys/portrait/item/tb.1.93296799.4nCBkGapSNihAglzWd7jig?t=1779722602",
      "url": "https://tieba.baidu.com/home/main?id=tb.1.93296799.4nCBkGapSNihAglzWd7jig%3Ft%3D1779722602"
    },
    "time": "2020-06-01 20:28",
    "tag": "313"
  },
  "tieba_6719317618": {
    "title": "【育种相关】一个雷门蔷薇的后代，花瓣非常有特色，是细长型，绒",
    "type": "月季",
    "segments": [
      {
        "t": "【育种相关】一个雷门蔷薇的后代，花瓣非常有特色，是细长型，绒球状，花瓣两侧边缘会有向内卷的现象，并带着白色的边缘。给大家推荐雷门蔷薇作为亲本，它的后代的花都挺有特点的，很多本来很普通的单瓣因为带上了它的翻卷特征看起来都非常有感觉。"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719317618_002.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719317618_003.webp"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_6719317618_004.webp"
      }
    ],
    "author": {
      "name": "云小123456",
      "avatar": "https://gss0.bdstatic.com/6LZ1dD3d1sgCo2Kml5_Y_D3/sys/portrait/item/tb.1.93296799.4nCBkGapSNihAglzWd7jig?t=1779722616",
      "url": "https://tieba.baidu.com/home/main?id=tb.1.93296799.4nCBkGapSNihAglzWd7jig%3Ft%3D1779722616"
    },
    "time": "2020-06-01 20:21",
    "tag": "314"
  },
