  "tieba_7825681949": {
    "title": "今日的水贴",
    "type": "月季",
    "segments": [
      {
        "t": "因为近来没啥花可看，下一批花要等点时间了，只能看看玫瑰的花，我在学习拍视频，以后大家可以看到动态的水贴啦"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/tieba_7825681949_000.webp"
