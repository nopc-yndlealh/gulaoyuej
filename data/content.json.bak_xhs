      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/succ_cd62b99ac2a7.png"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/succ_f134415f98b3.png"
      },
      {
        "t": "Plants in cultivation :\nA stolon producing roots\nPhoto Christophe Camassel"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/succ_bd79864b15b6.png"
      },
      {
        "t": "Photos Thomas Delange"
      },
      {
