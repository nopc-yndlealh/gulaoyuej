      {
        "t": "点击展开，查看完整图片"
      },
      {
        "t": "我的实拍"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_a3eb61e0c1fa.jpg"
      },
      {
        "t": "官方视频截图"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_90ec8c5b221d.jpg"
