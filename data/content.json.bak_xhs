  "rose_0637": {
    "title": "2022年巴塞罗那月季园非竞赛区现代品种",
    "segments": [
      {
        "t": "心之雕刻2019年参赛 没拿奖很美 很香 很矮 很紧凑 很抗病 但是花不多>"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_9912543f693c.jpg"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_39a812a81292.jpg"
