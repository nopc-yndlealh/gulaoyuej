      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_d0909a54af65.jpg"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_dfa9cb56df98.jpg"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_c643ce484a26.jpg"
