  "rose_0235": {
    "title": "小佳宝 is coming",
    "segments": [
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_5305ec2f2940.jpg"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_eac82655589e.jpg"
      },
      {
        "i": "https://pub-8b26014aee2c44c18d82a5187d985187.r2.dev/images/rose_b87c899738ce.jpg"
      },
      {
        "t": "迷你绝代佳人？'>"
      },
      {
        "t": "'>'>'>"
